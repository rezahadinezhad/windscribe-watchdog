<!-- Layout of the main window: a dark card in the spirit of Windscribe's own app. Loaded at run
     time by MainWindow.cs, which fills in the named elements and wires up the buttons. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="408"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.Foreground="#FFFFFF"
      SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Label" Color="#7F95B5"/>
    <SolidColorBrush x:Key="Muted" Color="#A9BCD6"/>
    <SolidColorBrush x:Key="Faint" Color="#6E84A3"/>
    <SolidColorBrush x:Key="Divider" Color="#1A2E4E"/>
    <SolidColorBrush x:Key="Accent" Color="#3BE0B0"/>

    <Style x:Key="Caps" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- On/off switch: teal track with a dark knob when on -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="24" Background="Transparent">
              <Border x:Name="Track" CornerRadius="12" Background="#22385A" BorderBrush="Transparent" BorderThickness="1.5"/>
              <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#8EA2BF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#3BE0B0"/>
                <Setter TargetName="Knob" Property="Fill" Value="#0B1830"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Minimize / hide in the title bar -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="#A9BCD6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#1F355A"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Outlined buttons at the bottom -->
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EEF9"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" CornerRadius="9" Background="#13284A" BorderBrush="#27456F" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#1A3560"/>
                <Setter TargetName="Back" Property="BorderBrush" Value="#3B6194"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#10223F"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Back" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text-only button ("Quit") -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="6,4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FF8A95"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The big ring draws its own look -->
    <Style x:Key="Bare" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="Face" RenderTransformOrigin="0.5,0.5"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section header that folds the activity list -->
    <Style x:Key="Fold" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent" Height="34">
              <ContentPresenter VerticalAlignment="Center"/>
              <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="#A9BCD6" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chevron" Property="Stroke" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- Shadow, on its own layer so it doesn't soften the text -->
  <Border x:Name="Shadow" Margin="14" CornerRadius="16" Background="#0B1628">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
  </Border>

  <Border x:Name="Card" Margin="14" CornerRadius="16" BorderBrush="#203A61" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#16305A" Offset="0"/>
        <GradientStop Color="#0D1C35" Offset="0.38"/>
        <GradientStop Color="#091425" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <!-- Soft glow in the status colour behind the ring -->
      <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-150,-150,0" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop x:Name="GlowStop" Color="#463BE0B0" Offset="0"/>
            <GradientStop x:Name="GlowEdge" Color="#003BE0B0" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <StackPanel>
        <!-- Title bar: drag it to move the window -->
        <Grid x:Name="TitleBar" Height="46" Background="Transparent" Margin="18,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="19" Height="19">
              <Canvas Width="24" Height="24">
                <Path Data="M12,1.5 L21,4.8 C21,13 17.5,19 12,22.5 C6.5,19 3,13 3,4.8 Z" Fill="{StaticResource Accent}"/>
                <Path Data="M7.5,12 L10.8,15.2 L16.5,8.8" Stroke="#0B1830" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="watchdog" FontSize="17" FontWeight="Bold" Margin="8,0,0,2" VerticalAlignment="Center"/>
            <Border BorderBrush="#4E6E98" BorderThickness="1" CornerRadius="4" Padding="5,1,5,2" Margin="9,1,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="FOR WINDSCRIBE" FontSize="8.5" FontWeight="Bold" Foreground="#9DB3D2"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Style="{StaticResource Chrome}" ToolTip="Minimize">
              <Path Data="M0,0 L10,0" Width="10" Height="1.4" Stretch="Fill" StrokeThickness="1.4"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource Chrome}" ToolTip="Hide (keeps watching from the tray)">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="Fill" StrokeThickness="1.4"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Status, location and the big on/off ring -->
        <Grid Margin="22,2,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Pill" CornerRadius="11" Padding="10,2,10,3" BorderThickness="1">
                <TextBlock x:Name="PillText" FontSize="11.5" FontWeight="Bold"/>
              </Border>
              <TextBlock x:Name="ProtocolText" FontSize="12.5" Foreground="{StaticResource Label}" Margin="10,0,0,0"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="PlaceText" Margin="0,12,0,0" FontSize="25" TextTrimming="CharacterEllipsis">
              <Run x:Name="CityRun" FontWeight="Bold"/>
              <Run x:Name="NickRun" FontWeight="Light" Foreground="#C9D7EA"/>
            </TextBlock>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,5,0,0"
                       TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button x:Name="RingButton" Grid.Column="1" Style="{StaticResource Bare}" Width="118" Height="118" Margin="0,2,0,0">
            <Grid>
              <Ellipse x:Name="RingGlow" StrokeThickness="10" Opacity="0.45" Margin="2">
                <Ellipse.Effect>
                  <BlurEffect Radius="16"/>
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse x:Name="Ring" StrokeThickness="6" Margin="3"/>
              <Ellipse Margin="15" Fill="#0C1C36" Stroke="#1D3A64" StrokeThickness="1"/>
              <Path x:Name="Spinner" Width="118" Height="118" Stretch="None" StrokeThickness="6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="#FFFFFF" Opacity="0.85"
                    Data="M59,6 A53,53 0 0 1 112,59" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                <Path.RenderTransform>
                  <RotateTransform x:Name="SpinnerTurn"/>
                </Path.RenderTransform>
              </Path>
              <Path x:Name="PowerIcon" Data="M6.34,6.34 A8,8 0 1 0 17.66,6.34 M12,2.5 L12,11"
                    StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="36" Height="38" Stretch="Uniform"/>
            </Grid>
          </Button>
        </Grid>

        <!-- Connection details -->
        <Grid Margin="22,14,22,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="VPN IP" Style="{StaticResource Caps}"/>
            <TextBlock x:Name="IpText" Style="{StaticResource Value}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="FIREWALL" Style="{StaticResource Caps}"/>
            <TextBlock x:Name="FirewallText" Style="{StaticResource Value}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="INTERNET" Style="{StaticResource Caps}"/>
            <TextBlock x:Name="InternetText" Style="{StaticResource Value}"/>
          </StackPanel>
        </Grid>

        <!-- Switches, today's numbers, activity and actions -->
        <Border Background="#0B1A31" BorderBrush="#1A3053" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15"
                Padding="22,4,18,12">
          <StackPanel>
            <Grid Margin="0,10,0,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AUTO-RECONNECT" Style="{StaticResource Caps}" Foreground="#DCE6F3"/>
                <TextBlock Text="Fixes drops, errors and frozen states" FontSize="11.5" Foreground="{StaticResource Faint}"
                           Margin="0,2,0,0"/>
              </StackPanel>
              <CheckBox x:Name="AutoToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" ToolTip="Auto-reconnect"/>
            </Grid>
            <Grid Margin="0,11,0,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="START WITH WINDOWS" Style="{StaticResource Caps}" Foreground="#DCE6F3"/>
                <TextBlock Text="And come back if it ever stops" FontSize="11.5" Foreground="{StaticResource Faint}"
                           Margin="0,2,0,0"/>
              </StackPanel>
              <CheckBox x:Name="StartupToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" ToolTip="Start with Windows"/>
            </Grid>
            <Grid Margin="0,11,0,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Caps}" Foreground="#DCE6F3"/>
                <TextBlock Text="When it fixes something or needs you" FontSize="11.5" Foreground="{StaticResource Faint}"
                           Margin="0,2,0,0"/>
              </StackPanel>
              <CheckBox x:Name="NotifyToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" ToolTip="Notifications"/>
            </Grid>

            <Border Height="1" Background="{StaticResource Divider}" Margin="0,13,0,10"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,30,0">
                <TextBlock Text="FIXED TODAY" Style="{StaticResource Caps}"/>
                <TextBlock x:Name="FixesText" FontSize="22" FontWeight="Bold" Margin="0,1,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="LAST FIX" Style="{StaticResource Caps}"/>
                <TextBlock x:Name="LastFixText" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource Divider}" Margin="0,10,0,0"/>

            <ToggleButton x:Name="ActivityFold" Style="{StaticResource Fold}">
              <TextBlock Text="ACTIVITY" Style="{StaticResource Caps}"/>
            </ToggleButton>
            <StackPanel x:Name="ActivityList" Visibility="Collapsed" Margin="0,0,0,6"/>

            <Grid Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="RestartButton" Style="{StaticResource Action}" Content="Restart Windscribe"
                        ToolTip="Closes and reopens the Windscribe app, then reconnects"/>
                <Button x:Name="LogButton" Style="{StaticResource Action}" Content="Open log" Margin="8,0,0,0"/>
              </StackPanel>
              <Button x:Name="QuitButton" Style="{StaticResource Link}" Content="Quit" HorizontalAlignment="Right"
                      VerticalAlignment="Center" ToolTip="Stop the watchdog until you start it again"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</Grid>
